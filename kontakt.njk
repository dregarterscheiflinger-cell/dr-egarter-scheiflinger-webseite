---
layout: base.njk
title: "Kontakt & Termin | Dr. Karin Egarter-Scheiflinger"
description: "Kontakt und Terminvereinbarung für die Wahlarztordination Dr. Egarter-Scheiflinger in Spittal/Drau. Adresse, Öffnungszeiten, Anfahrt und Online-Terminbuchung."
currentPage: "kontakt.html"
permalink: "kontakt.html"
---
  <div class="container page-header">
    <span class="eyebrow">Kontakt</span>
    <h1>{{ kontakt.page_header.heading }}</h1>
    <p class="lede">{{ kontakt.page_header.lede }}</p>
  </div>

  <div class="container" style="margin-bottom:12px;">
    <img src="{{ kontakt.hero_image }}" alt="{{ kontakt.hero_image_alt }}" loading="lazy" style="width:100%; aspect-ratio:21/9; max-height:340px; object-fit:cover; border-radius:var(--radius-lg); box-shadow:var(--shadow-md);">
  </div>

  <!-- Contact details + map -->
  <div class="section section--tight">
    <div class="container contact-grid">
      <div class="contact-card">
        <h3 style="margin-bottom:16px;">Kontaktdaten</h3>
        <div class="contact-line">
          <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <strong>Adresse</strong>
            {{ site.address.street }}, {{ site.address.zip }} {{ site.address.city }}
          </div>
        </div>
        <div class="contact-line">
          <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <div>
            <strong>Telefon</strong>
            <span><a href="tel:{{ site.phone_tel }}" style="text-decoration:underline;">{{ site.phone }}</a></span><br>
            <span style="font-size:0.85rem; color:var(--gray-500);">{{ kontakt.kontaktdaten.telefon_hinweis }}</span>
          </div>
        </div>
        <div class="contact-line">
          <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/></svg>
          <div>
            <strong>E-Mail</strong>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            <span style="display:block; font-size:0.82rem; color:var(--gray-500); margin-top:6px;">{{ kontakt.kontaktdaten.email_hinweis }}</span>
          </div>
        </div>
        <div class="contact-line">
          <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <strong>Ordinationszeiten</strong>
            <table class="hours-table" style="margin-top:6px;">
              {%- for h in site.hours %}
              <tr><td>{{ h.day }}</td><td>{{ h.time }}</td></tr>
              {%- endfor %}
            </table>
            <p style="margin-top:8px; font-size:0.85rem; color:var(--gray-500);">{{ kontakt.kontaktdaten.oeffnungszeiten_hinweis }}</p>
          </div>
        </div>
      </div>

      <div>
        <div class="map-frame">
          <iframe
            src="{{ kontakt.karte.iframe_src | safe }}"
            title="{{ kontakt.karte.iframe_title }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
        <p style="font-size:0.82rem; color:var(--gray-500); margin-top:10px;">{{ kontakt.karte.hinweis | safe }}</p>
      </div>
    </div>
  </div>

  <!-- Booking -->
  <div class="section section--gray" id="termin">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Terminvereinbarung</span>
        <h2>Termin buchen</h2>
        <p class="lede">{{ kontakt.booking.lede }}</p>
      </div>
      <div class="booking-placeholder">
        {% icon "calendar", {size: 34, strokeWidth: 1.7} %}
        <h3>{{ kontakt.booking.placeholder_heading }}</h3>
        <code><!-- TODO: TermiOn Embed-/iFrame-Code hier einfügen --></code>
      </div>
    </div>
  </div>

  <!-- Organisatorisches -->
  <div class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Organisatorisches</span>
        <h2>{{ kontakt.organisatorisches.heading }}</h2>
      </div>

      <div class="split">
        <div class="info-box">
          <h3 style="margin-bottom:10px;">E-Card</h3>
          <p style="color:var(--gray-700);">{{ kontakt.organisatorisches.ecard_text }}</p>
          <div class="notice" style="margin-top:16px;">
            {% icon "alert-circle", {size: 20, strokeWidth: 1.8} %}
            <span>{{ kontakt.organisatorisches.ecard_notice }}</span>
          </div>
        </div>
        <div class="info-box">
          <h3 style="margin-bottom:10px;">Rezeptbestellung</h3>
          <p style="color:var(--gray-700);">{{ kontakt.organisatorisches.rezept_text | safe }}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Wahlarzt Erklärung -->
  <div class="section section--gray">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Wahlarztordination</span>
          <h2>{{ kontakt.wahlarzt.heading }}</h2>
        </div>
        <div>
          <p>{{ kontakt.wahlarzt.text }}</p>
        </div>
      </div>
    </div>
  </div>
