<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
<link rel="icon" type="image/svg+xml" href="images/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="images/favicon-32.png">
<link rel="apple-touch-icon" href="images/apple-touch-icon.png">
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Zum Inhalt springen</a>

{%- if site.ankuendigung.aktiv %}
<div class="announcement-modal-backdrop" id="announcement-modal" data-announcement-text="{{ site.ankuendigung.text }}">
  <div class="announcement-modal" role="dialog" aria-label="Ankündigung">
    <button type="button" class="announcement-modal-close" aria-label="Schließen">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    {% icon "alert-circle", {size: 28, strokeWidth: 1.8} %}
    <p>{{ site.ankuendigung.text }}</p>
  </div>
</div>
{%- endif %}

{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

{% include "partials/cookie-banner.njk" %}

<script src="js/main.js"></script>
</body>
</html>
