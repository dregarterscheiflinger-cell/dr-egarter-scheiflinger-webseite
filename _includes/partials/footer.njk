<footer class="site-footer">
  <div class="container">
    <a class="footer-logo" href="index.html">
      <img src="images/logo.png" alt="Dr. Egarter-Scheiflinger Logo">
    </a>
  </div>
  <div class="container footer-grid">
    <div class="footer-col">
      <h3>Ordination</h3>
      <address>
        {{ site.name }}<br>
        {{ site.address.street }}<br>
        {{ site.address.zip }} {{ site.address.city }}
      </address>
      <p style="margin-top:10px;">{{ footerTagline or site.tagline }}</p>
    </div>
    <div class="footer-col">
      <h3>Ordinationszeiten</h3>
      <table class="footer-hours">
        {%- for h in site.hours %}
        <tr><td>{{ h.day }}</td><td>{{ h.time }}</td></tr>
        {%- endfor %}
      </table>
      <p style="margin-top:8px; font-size:0.85rem;">und nach telefonischer Vereinbarung</p>
    </div>
    <div class="footer-col">
      <h3>Navigation</h3>
      <ul class="footer-links">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <span id="footer-year">2026</span> {{ site.name }}</span>
    <span><a href="impressum.html">Impressum</a> &nbsp;·&nbsp; <a href="datenschutz.html">Datenschutz</a></span>
  </div>
</footer>
