---
layout: base.njk
title: "Dr. Karin Egarter-Scheiflinger | Wahlarztordination für Innere Medizin, Nierengesundheit & Bluthochdruck in Spittal/Drau"
description: "Wahlarztordination von Dr. Karin Egarter-Scheiflinger in Spittal/Drau. Fachärztin für Innere Medizin, Nierengesundheit und Bluthochdruck sowie Allgemeinmedizin. Persönliche Betreuung, moderne Diagnostik."
currentPage: "index.html"
permalink: "index.html"
extraHead: |
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": "Dr. Karin Egarter-Scheiflinger",
    "image": "https://www.dr-egarter-scheiflinger.at/images/portrait.jpg",
    "medicalSpecialty": ["Internal Medicine", "Nephrology"],
    "description": "Wahlarztordination für Innere Medizin, Nierengesundheit und Bluthochdruck sowie Allgemeinmedizin in Spittal/Drau.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Tirolerstraße 18/1",
      "addressLocality": "Spittal an der Drau",
      "postalCode": "9800",
      "addressCountry": "AT"
    },
    "telephone": "+43 4762 41952",
    "email": "ordination@dr-egarter-scheiflinger.at",
    "url": "https://www.dr-egarter-scheiflinger.at/",
    "isAcceptingNewPatients": true,
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "07:30", "closes": "14:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "07:30", "closes": "13:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "14:00", "closes": "18:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "07:30", "closes": "14:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "07:30", "closes": "14:00" }
    ]
  }
  </script>
---

  <!-- Hero Slideshow -->
  <div class="hero-slideshow" role="region" aria-label="Impressionen aus der Ordination">
    {%- for slide in home.hero_slides %}
    <div class="hero-slide{% if loop.first %} is-active{% endif %}"><img src="{{ slide.image }}" alt="{{ slide.alt }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}"></div>
    {%- endfor %}
    <div class="hero-slideshow-dots"></div>
  </div>

  <!-- Intro -->
  <div class="container">
    <div class="intro">
      <div class="intro-portrait">
        <img src="{{ site.portrait_image }}" alt="Portrait von Dr. Karin Egarter-Scheiflinger">
        <p>{{ site.name }}</p>
        <span>Fachärztin für Innere Medizin, Nierengesundheit &amp; Bluthochdruck</span>
      </div>
      <div class="intro-text">
        <h1>{{ home.intro.heading }}</h1>
        <p class="lede">{{ home.intro.lede }}</p>
        <p>{{ home.intro.text }}</p>
        <div class="intro-cta">
          <a class="btn btn-primary" href="kontakt.html#termin">Termin vereinbaren</a>
          <a class="btn btn-outline" href="leistungen.html">Leistungen ansehen</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick facts -->
  <div class="container quick-facts-wrap">
    <div class="quick-facts">
      {%- for fact in home.quick_facts %}
      <div class="quick-fact">
        {% icon fact.icon, {size: 26, strokeWidth: 1.8} %}
        <div>
          <h3>{{ fact.title }}</h3>
          <p>{{ fact.text | safe }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>

  <!-- Service teasers -->
  <div class="section section--gray">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Leistungen</span>
        <h2>{{ home.leistungen_teaser.heading }}</h2>
        <p class="lede">{{ home.leistungen_teaser.lede }}</p>
      </div>
      <div class="card-grid">
        {%- for card in home.leistungen_teaser.cards %}
        <div class="service-card">
          {% icon card.icon, {size: 30} %}
          <h3>{{ card.title | safe }}</h3>
          <p>{{ card.text | safe }}</p>
          <a class="card-link" href="{{ card.link }}">Mehr erfahren →</a>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>

  <!-- First visit -->
  <div class="section">
    <div class="container">
      <div class="split split--reverse">
        <div>
          <span class="eyebrow">Erstbesuch</span>
          <h2>{{ home.erstbesuch.heading }}</h2>
          <p class="lede" style="margin-top:12px;">{{ home.erstbesuch.text }}</p>
        </div>
        <img src="{{ home.erstbesuch.image }}" alt="{{ home.erstbesuch.image_alt }}" loading="lazy">
      </div>
    </div>
  </div>

  <!-- What to bring -->
  <div class="section section--gray">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Erstordination</span>
          <h2>{{ home.mitbringen.heading }}</h2>
          <p class="lede" style="margin-top:12px;">{{ home.mitbringen.text }}</p>
        </div>
        <div class="info-box">
          <ul class="check-list">
            {%- for item in home.mitbringen.items %}
            <li>{% icon "check-circle", {size: 20, strokeWidth: 2} %}<span>{{ item | safe }}</span></li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Wahlarzt explanation -->
  <div class="section section--tint">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Wahlarztordination</span>
        <h2>{{ home.wahlarzt.heading }}</h2>
        <p class="lede">{{ home.wahlarzt.text }}</p>
      </div>
    </div>
  </div>

  <!-- Quote -->
  <div class="section section--bordeaux">
    <div class="container">
      <div class="quote-block">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M7 11c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3c0 3.3-2.4 6.1-5.5 6.9l-.5-1.4C6.2 12.9 7 12 7 11zm10 0c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3c0 3.3-2.4 6.1-5.5 6.9l-.5-1.4c2.2-.6 3-1.5 3-2.5z"/></svg>
        <blockquote>{{ home.quote }}</blockquote>
      </div>
    </div>
  </div>

  <!-- Final CTA -->
  <div class="section">
    <div class="container">
      <div class="info-box info-box--bordeaux" style="display:flex; flex-wrap:wrap; gap:20px; align-items:center; justify-content:space-between;">
        <div>
          <h2 style="margin-bottom:0;">{{ home.final_cta_heading }}</h2>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a class="btn btn-primary" href="kontakt.html#termin">Termin buchen</a>
          <a class="btn btn-outline" href="kontakt.html">Kontakt</a>
        </div>
      </div>
    </div>
  </div>
