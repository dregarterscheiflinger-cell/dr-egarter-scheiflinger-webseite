---
layout: base.njk
title: "Über mich | Dr. Karin Egarter-Scheiflinger"
description: "Lernen Sie Dr. Karin Egarter-Scheiflinger kennen: Werdegang, Ausbildung und Diplome der Fachärztin für Innere Medizin, Nierengesundheit und Bluthochdruck."
currentPage: "ueber-mich.html"
permalink: "ueber-mich.html"
---

  <div class="container">
    <div class="intro" style="padding-block:44px 40px;">
      <div class="intro-portrait" style="align-self:start;">
        <img src="images/portrait.jpg" alt="Portrait von Dr. Karin Egarter-Scheiflinger" style="margin-top:0;">
      </div>
      <div class="intro-text">
        <span class="eyebrow">Über mich</span>
        <h1>Dr. Karin Egarter-Scheiflinger</h1>
        <ul class="badge-row">
          {%- for badge in ueberMich.badges %}
          <li>{{ badge }}</li>
          {%- endfor %}
        </ul>
        {%- for p in ueberMich.intro %}
        <p>{{ p }}</p>
        {%- endfor %}
      </div>
    </div>
  </div>

  <!-- Werdegang / Timeline -->
  <div class="section section--gray">
    <div class="container">
      <div class="split" style="align-items:center;">
        <div>
          <span class="eyebrow">Werdegang</span>
          <h2>{{ ueberMich.werdegang.heading }}</h2>
          <p class="lede" style="margin:12px 0 24px;">{{ ueberMich.werdegang.lede }}</p>
          <img src="{{ ueberMich.werdegang.image }}" alt="{{ ueberMich.werdegang.image_alt }}" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">
        </div>
        <div>
        <div class="h-scroll-wrap">
          <button type="button" class="h-scroll-btn h-scroll-prev" aria-label="Zurück"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button type="button" class="h-scroll-btn h-scroll-next" aria-label="Weiter"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
          <div class="timeline h-scroll-track">
            {%- for item in ueberMich.timeline %}
            <div class="timeline-item">
              <span class="timeline-year">{{ item.jahr }}</span>
              <h3>{{ item.titel }}</h3>
              <p>{{ item.text }}</p>
            </div>
            {%- endfor %}
          </div>
        </div>
        <div class="mini-quote">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M7 11c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3c0 3.3-2.4 6.1-5.5 6.9l-.5-1.4C6.2 12.9 7 12 7 11zm10 0c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3c0 3.3-2.4 6.1-5.5 6.9l-.5-1.4c2.2-.6 3-1.5 3-2.5z"/></svg>
          <blockquote>{{ ueberMich.quote }}</blockquote>
        </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Diplome -->
  <div class="section">
    <div class="container">
      <span class="eyebrow">Qualifikationen</span>
      <h2>Diplome</h2>
      <div class="credential-badges" style="margin-top:22px;">
        {%- for d in ueberMich.diplome %}
        <div class="credential-badge">
          <div class="icon-circle">{% icon d.icon, {size: 21, class: ""} %}</div>
          <span>{{ d.text }}</span>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>

  <!-- Weitere Ausbildungen -->
  <div class="section section--gray">
    <div class="container">
      <h2>Weitere Ausbildungen</h2>
      <div class="credential-list" style="margin-top:22px;">
        {%- for a in ueberMich.weitere_ausbildungen %}
        <div class="credential-row">
          <div class="icon-circle">{% icon a.icon, {size: 19, class: ""} %}</div>
          <span>{{ a.text }}</span>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>

  <div class="section section--gray">
    <div class="container">
      <div class="info-box info-box--bordeaux" style="display:flex; flex-wrap:wrap; gap:20px; align-items:center; justify-content:space-between;">
        <div>
          <h2 style="margin-bottom:6px;">{{ ueberMich.final_cta.heading }}</h2>
          <p style="color:var(--gray-700);">{{ ueberMich.final_cta.text }}</p>
        </div>
        <a class="btn btn-primary" href="kontakt.html#termin">Termin buchen</a>
      </div>
    </div>
  </div>
