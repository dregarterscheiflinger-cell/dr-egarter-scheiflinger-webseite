---
layout: base.njk
title: "Leistungen | Dr. Karin Egarter-Scheiflinger"
description: "Leistungen der Wahlarztordination Dr. Egarter-Scheiflinger: Innere Medizin, Diagnostik, Vorsorge, OP-Freigabe, Manager-Check und Nierengesundheit."
currentPage: "leistungen.html"
permalink: "leistungen.html"
---

  <div class="container page-header">
    <span class="eyebrow">Leistungen</span>
    <h1>Ein breites Spektrum der Inneren Medizin</h1>
    <p class="lede">Mit ausreichend Zeit für ein persönliches Gespräch und Untersuchungen auf dem neuesten medizinischen Stand.</p>
  </div>

  <div class="section section--tight">
    <div class="container">
      <div class="accordion">

        {%- for item in leistungen %}
        <details class="accordion-item" id="{{ item.id }}"{% if item.open %} open{% endif %}>
          <summary>
            {% icon item.icon, {size: 24, strokeWidth: 1.7} %}
            <span>{{ item.title }}</span>
            <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="accordion-body">
            <img class="accordion-image" src="{{ item.image }}" alt="{{ item.image_alt }}" loading="lazy">
            {%- for p in item.intro %}
            <p>{{ p | safe }}</p>
            {%- endfor %}
            {%- if item.krankheitsbilder %}
            <ul class="disease-grid">
              {%- for k in item.krankheitsbilder %}
              <li>{{ k }}</li>
              {%- endfor %}
            </ul>
            {%- endif %}
            {%- if item.begriffsliste %}
            <dl class="def-list">
              {%- for b in item.begriffsliste %}
              <dt>{{ b.begriff }}</dt>
              <dd>{{ b.beschreibung | safe }}</dd>
              {%- endfor %}
            </dl>
            {%- endif %}

            {%- for gruppe in item.gruppen %}
            <div class="sub-accordion">
              {%- for up in gruppe.unterpunkte %}
              <details class="sub-accordion-item">
                <summary><span>{{ up.titel }}</span><svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></summary>
                <div class="sub-accordion-body">{% if up.begriffsliste %}
                  <dl class="def-list">
                    {%- for b in up.begriffsliste %}
                    <dt>{{ b.begriff }}</dt>
                    <dd>{{ b.beschreibung | safe }}</dd>
                    {%- endfor %}
                  </dl>
                {% else %}<p>{{ up.text | safe }}</p>{% endif %}</div>
              </details>
              {%- endfor %}
            </div>
            {%- endfor %}
          </div>
        </details>
        {%- endfor %}

      </div>
    </div>
  </div>

